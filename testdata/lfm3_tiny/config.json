{
  "architectures": [
    "Lfm3VlForConditionalGeneration"
  ],
  "model_type": "lfm3_vl",
  "text_config": {
    "model_type": "lfm3",
    "vocab_size": 128,
    "hidden_size": 32,
    "intermediate_size": 64,
    "num_hidden_layers": 6,
    "layer_types": [
      "conv",
      "sliding_attention",
      "full_attention",
      "conv",
      "sliding_attention",
      "full_attention"
    ],
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "head_dim": 8,
    "norm_eps": 1e-05,
    "conv_L_cache": 7,
    "conv_bias": false,
    "sliding_window": 8,
    "use_sandwich_norm": true,
    "tie_word_embeddings": true,
    "max_position_embeddings": 4096,
    "rope_parameters": {
      "full_attention": {
        "rope_theta": 1000000.0,
        "partial_rotary_factor": 0.5
      },
      "sliding_attention": {
        "rope_theta": 10000.0
      }
    }
  },
  "tie_word_embeddings": true
}
